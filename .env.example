# açaínfe (front) — variáveis de ambiente.
# Copie para .env e preencha. Nunca commite o .env.
# No Replit, use Secrets/Env Vars em vez deste arquivo.

# --- API do açaínfe (https://github.com/extractify/acainfe-api) ---
# Endereço da API. Em produção: https://api.acainfe.com. Localmente: http://localhost:3000
ACAINFE_API_URL=http://localhost:3000
# Chave de app das rotas privadas (/v1/app/*): o mesmo valor de APP_API_KEY na API.
# Segredo do servidor: nunca use prefixo VITE_.
ACAINFE_APP_KEY=troque-por-uma-chave-de-app

# --- Clerk (autenticação) ---
# Crie uma aplicação em https://dashboard.clerk.com e copie as chaves.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=cole-aqui-a-secret-key-do-clerk
# Mesma chave publicável, exposta ao navegador pelo Vite.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: URL do proxy do Clerk (domínio próprio). Em branco usa o padrão.
VITE_CLERK_PROXY_URL=

# --- Servidor ---
# Porta do Express (padrão 5000).
PORT=5000
# Opcional: caminho base quando o app não está na raiz do domínio (padrão /).
BASE_PATH=/
# development (Vite em middleware) ou production (serve dist/ — rode o build antes).
NODE_ENV=development

# --- CLI (artifacts/acainfe/cli) ---
# Chave de API da empresa, gerada no app (Agentes de IA). Usada só pela CLI.
ACAINFE_API_KEY=
