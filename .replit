modules = ["nodejs-22", "postgresql-16"]

[workflows]
runButton = "Project"

[userenv]

[userenv.shared]
ACAINFE_API_URL = "https://flowing-rabbit-still.ngrok-free.app"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 21280
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3003

[[ports]]
localPort = 24678
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "--filter", "@workspace/acainfe", "run", "start"]
build = ["pnpm", "--filter", "@workspace/acainfe", "run", "build"]
